# --- Orchestrator HTTP API (web app calls this service) ---
ORCHESTRATOR_HOST=0.0.0.0
ORCHESTRATOR_PORT=8000

# --- Web app (orchestrator sends signed events here) ---
WEB_APP_URL=http://127.0.0.1:8001
# Shared secret for HMAC-SHA256 on commands and events (min 32 chars in production)
HMAC_SECRET=change-me-use-a-long-random-string-in-production

# --- Concurrency and health ---
GLOBAL_CONCURRENT_CAP=10
HEARTBEAT_TIMEOUT_SECS=120
MAX_CALL_SECS=1800

# --- SQLite persistence ---
SQLITE_PATH=./data/orchestrator.db

# --- Caller ID pool defaults ---
POOL_TIMEZONE=America/New_York
NUMBER_DAILY_CAP_DEFAULT=75
NUMBER_COOLDOWN_SECS=600
DIAL_SPACING_MIN_SECS=20
DIAL_SPACING_MAX_SECS=30

# --- Outbox (event delivery to web app) ---
OUTBOX_MAX_RETRIES=10
OUTBOX_INITIAL_BACKOFF_SECS=1
OUTBOX_MAX_BACKOFF_SECS=300

# --- Backends (fake in this phase; swap via env later) ---
TELEPHONY_BACKEND=fake
AGENT_BACKEND=fake

# --- Fake telephony simulation (probabilities must sum to 1.0) ---
FAKE_NO_ANSWER_PROB=0.55
FAKE_VOICEMAIL_PROB=0.10
FAKE_BUSY_PROB=0.05
FAKE_ANSWERED_PROB=0.30

# --- Fake agent simulation ---
FAKE_AGENT_MIN_DURATION_SECS=20
FAKE_AGENT_MAX_DURATION_SECS=90

# --- Logging ---
LOG_LEVEL=INFO

# --- Tests only: skip dialer/outbox/watchdog when using FastAPI TestClient ---
# ORCHESTRATOR_DISABLE_LOOPS=1